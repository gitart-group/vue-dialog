{
  "name": "gitart-vue-dialog",
  "version": "3.1.0",
  "keywords": [
    "gitart",
    "gitart dialog",
    "gitart-vue-dialog",
    "vue",
    "vue 3",
    "vue3",
    "dialog",
    "modal",
    "dialog component",
    "modal component",
    "vue modal",
    "vue3 modal",
    "vue dialog",
    "vue3 dialog"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gitart-group/vue-dialog.git",
    "directory": "."
  },
  "author": {
    "name": "Michael Gitart",
    "email": "michaelgitart@gmail.com"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "scripts": {
    "dev": "vite --config dev/vite.config.ts",
    "typecheck": "vue-tsc --noEmit",
    "build:bundle": "vite build --config build/vite.config.ts",
    "build:types": "vue-tsc --declaration --emitDeclarationOnly -p ./build/tsconfig.json",
    "build": "npm run typecheck && npm run build:bundle && npm run build:types",
    "lint": "npm run stylelint && npm run eslint",
    "stylelint": "stylelint \"src/**/*.{vue,scss}\"",
    "eslint": "eslint . --ext .js,.ts,.vue",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "types": "./dist/index.d.ts",
  "packageManager": "pnpm@11.2.2",
  "peerDependencies": {
    "vue": "^3.2.47"
  },
  "dependencies": {
    "gitart-manage-vue-dialog": "^1.0.1"
  },
  "devDependencies": {
    "@gitart/eslint-config-vue": "0.3.0",
    "@types/node": "^25.9.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/compiler-sfc": "^3.5.34",
    "@vue/runtime-core": "^3.5.34",
    "@vue/test-utils": "^2.4.10",
    "@vueuse/core": "^14.3.0",
    "eslint": "^10.4.0",
    "happy-dom": "^20.9.0",
    "postcss-html": "^1.8.1",
    "postcss-scss": "^4.0.9",
    "sass": "^1.100.0",
    "stylelint": "^17.12.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.0.14",
    "vite-plugin-windicss": "^1.9.4",
    "vitest": "^4.1.7",
    "vue": "^3.5.34",
    "vue-tsc": "^3.3.1",
    "windicss": "^3.5.6"
  }
}
